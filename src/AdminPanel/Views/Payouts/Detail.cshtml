@* src/AdminPanel/Views/Payouts/Detail.cshtml *@
@using AdminPanel.Helpers
@using AdminPanel.ViewModels.Payments
@model PayoutDetailViewModel
@{
    ViewData["Title"] = "Payout Detail";
    var badge = BadgeHelper.Payout(Model.Status);
}

<div class="pg-bar">
    <div>
        <div class="pg-eyebrow">
            <a asp-action="Index">Payouts</a>
            <span class="pg-eyebrow-sep">›</span>
            <span>Detail</span>
        </div>
        <h1 class="pg-title">Payout</h1>
        <p class="pg-sub">
            <span class="tbl-mono" style="font-size:13px">@Model.Id</span>
            · <span class="badge @badge.CssClass">@badge.Label</span>
        </p>
    </div>
    <div class="pg-actions">
        <a asp-action="Index" class="btn btn-outline btn-sm">← Back</a>
    </div>
</div>

<partial name="_AlertBanner" />

<div class="detail-grid">

    <div class="detail-main">

        <div class="card">
            <div class="card-head"><div class="card-title">Payout Information</div></div>
            <div class="card-body">
                <div class="field-grid-2">
                    <div class="form-group">
                        <label class="form-label">Seller</label>
                        <div style="font-size:13.5px;color:var(--c-ink);
                                    font-weight:600;padding:9px 0">
                            @(Model.SellerName ?? Model.SellerId.ToString())
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Amount</label>
                        <div class="price" style="font-size:22px;padding:9px 0">
                            ₹@Model.Amount.ToString("N2")
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="card">
            <div class="card-head"><div class="card-title">Payment Account</div></div>
            <div class="card-body">
                @if (!string.IsNullOrWhiteSpace(Model.UpiId))
                {
                    <div class="detail-kv">
                        <span class="detail-k">UPI ID</span>
                        <span class="detail-v tbl-mono">@Model.UpiId</span>
                    </div>
                }
                else if (!string.IsNullOrWhiteSpace(Model.BankAccountNumber))
                {
                    <div class="detail-kv">
                        <span class="detail-k">Account Name</span>
                        <span class="detail-v">@Model.BankAccountName</span>
                    </div>
                    <div class="detail-kv">
                        <span class="detail-k">Account Number</span>
                        <span class="detail-v tbl-mono">@Model.BankAccountNumber</span>
                    </div>
                    <div class="detail-kv">
                        <span class="detail-k">IFSC Code</span>
                        <span class="detail-v tbl-mono">@Model.BankIfscCode</span>
                    </div>
                }
                else
                {
                    <p style="font-size:13px;color:var(--c-ink-4)">
                        No payment details provided.
                    </p>
                }
            </div>
        </div>

        @if (!string.IsNullOrEmpty(Model.AdminNote)
                || !string.IsNullOrEmpty(Model.GatewayReference)
                || !string.IsNullOrEmpty(Model.FailureReason))
        {
            <div class="card">
                <div class="card-head"><div class="card-title">Admin Notes</div></div>
                <div class="card-body">
                    @if (!string.IsNullOrEmpty(Model.GatewayReference))
                    {
                        <div class="detail-kv">
                            <span class="detail-k">Gateway Ref</span>
                            <span class="detail-v tbl-mono">@Model.GatewayReference</span>
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(Model.AdminNote))
                    {
                        <div style="margin-top:12px">
                            <label class="form-label">Admin Note</label>
                            <div style="font-size:13.5px;color:var(--c-ink-2);
                                                margin-top:4px;line-height:1.6">
                                @Model.AdminNote
                            </div>
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(Model.FailureReason))
                    {
                        <div style="margin-top:12px">
                            <label class="form-label" style="color:var(--c-rose)">
                                Failure / Cancel Reason
                            </label>
                            <div style="font-size:13.5px;color:var(--c-rose);
                                                margin-top:4px;line-height:1.6">
                                @Model.FailureReason
                            </div>
                        </div>
                    }
                </div>
            </div>
        }

    </div>

    <div class="detail-side">

        <div class="card">
            <div class="card-head"><div class="card-title">Timeline</div></div>
            <div class="card-body">
                <div class="detail-kv">
                    <span class="detail-k">Requested</span>
                    <span class="detail-v tbl-date">
                        @Model.CreatedAt.ToString("dd MMM yyyy, HH:mm")
                    </span>
                </div>
                @if (Model.ProcessedAt.HasValue)
                {
                    <div class="detail-kv">
                        <span class="detail-k">Processing</span>
                        <span class="detail-v tbl-date">
                            @Model.ProcessedAt.Value.ToString("dd MMM yyyy, HH:mm")
                        </span>
                    </div>
                }
                @if (Model.CompletedAt.HasValue)
                {
                    <div class="detail-kv">
                        <span class="detail-k">Completed</span>
                        <span class="detail-v tbl-date" style="color:var(--c-emerald)">
                            @Model.CompletedAt.Value.ToString("dd MMM yyyy, HH:mm")
                        </span>
                    </div>
                }
                @if (Model.FailedAt.HasValue)
                {
                    <div class="detail-kv">
                        <span class="detail-k">Failed</span>
                        <span class="detail-v tbl-date" style="color:var(--c-rose)">
                            @Model.FailedAt.Value.ToString("dd MMM yyyy, HH:mm")
                        </span>
                    </div>
                }
                @if (Model.CancelledAt.HasValue)
                {
                    <div class="detail-kv">
                        <span class="detail-k">Cancelled</span>
                        <span class="detail-v tbl-date" style="color:var(--c-ink-4)">
                            @Model.CancelledAt.Value.ToString("dd MMM yyyy, HH:mm")
                        </span>
                    </div>
                }
            </div>
        </div>

        @if (Model.CanProcess)
        {
            <div class="card" style="border-color:#c7d2fe">
                <div class="card-head"
                     style="background:var(--c-indigo-lt);border-color:#c7d2fe">
                    <div class="card-title" style="color:var(--c-indigo)">
                        Start Processing
                    </div>
                </div>
                <div class="card-body">
                    <form asp-action="Process" asp-route-id="@Model.Id" method="post">
                        @Html.AntiForgeryToken()
                        <div class="form-group" style="margin-bottom:10px">
                            <label class="form-label">Admin Note (optional)</label>
                            <textarea name="adminNote" class="form-textarea" rows="2"
                                  placeholder="Internal note…"></textarea>
                        </div>
                        <button type="submit" class="btn btn-indigo btn-sm"
                                style="width:100%;justify-content:center">
                            Mark as Processing
                        </button>
                    </form>
                </div>
            </div>
        }

        @if (Model.CanComplete)
        {
            <div class="card" style="border-color:#bbf7d0">
                <div class="card-head"
                     style="background:var(--c-emerald-lt);border-color:#bbf7d0">
                    <div class="card-title" style="color:var(--c-emerald)">
                        Complete Payout
                    </div>
                </div>
                <div class="card-body">
                    <form asp-action="Complete" asp-route-id="@Model.Id" method="post">
                        @Html.AntiForgeryToken()
                        <div class="form-group" style="margin-bottom:10px">
                            <label class="form-label">
                                Gateway Reference <span>*</span>
                            </label>
                            <input type="text" name="gatewayReference"
                                   class="form-input"
                                   placeholder="NEFT/IMPS/UPI reference…"
                                   required />
                        </div>
                        <div class="form-group" style="margin-bottom:10px">
                            <label class="form-label">Admin Note (optional)</label>
                            <input type="text" name="adminNote" class="form-input" />
                        </div>
                        <button type="submit" class="btn btn-primary btn-sm"
                                style="width:100%;justify-content:center">
                            Mark as Completed
                        </button>
                    </form>
                </div>
            </div>
        }

        @if (Model.CanFail || Model.CanCancel)
        {
            <div class="card card--danger">
                <div class="card-head card-head--danger">
                    <div class="card-title card-title--danger">
                        @(Model.CanFail ? "Mark as Failed" : "Cancel Payout")
                    </div>
                </div>
                <div class="card-body" style="display:flex;flex-direction:column;gap:12px">
                    @if (Model.CanFail)
                    {
                        <form asp-action="Fail" asp-route-id="@Model.Id" method="post">
                            @Html.AntiForgeryToken()
                            <div class="form-group" style="margin-bottom:10px">
                                <label class="form-label">Reason <span>*</span></label>
                                <textarea name="reason" class="form-textarea" rows="2"
                                  placeholder="Reason for failure…" required></textarea>
                            </div>
                            <button type="submit" class="btn btn-danger btn-sm"
                                    style="width:100%;justify-content:center">
                                Mark Failed
                            </button>
                        </form>
                    }
                    @if (Model.CanCancel)
                    {
                        <form asp-action="Cancel" asp-route-id="@Model.Id" method="post">
                            @Html.AntiForgeryToken()
                            <div class="form-group" style="margin-bottom:10px">
                                <label class="form-label">Reason <span>*</span></label>
                                <textarea name="reason" class="form-textarea" rows="2"
                                  placeholder="Reason for cancellation…" required></textarea>
                            </div>
                            <button type="submit" class="btn btn-danger btn-sm"
                                    style="width:100%;justify-content:center">
                                Cancel Payout
                            </button>
                        </form>
                    }
                </div>
            </div>
        }

    </div>
</div>