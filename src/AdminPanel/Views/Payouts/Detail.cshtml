@using AdminPanel.ViewModels.Payments
@model PayoutDetailViewModel
@{
    ViewData["Title"] = "Payout Detail";
    Layout = "_AdminLayout";
    var badge = BadgeHelper.Payout(Model.Status);
}

<div class="d-flex align-items-center gap-3 mb-4">
    <a href="@Url.Action("Index")" class="btn btn-sm btn-outline-secondary">
        <i class="bi bi-arrow-left"></i> Back
    </a>
    <div>
        <h1 class="h4 mb-0">Payout Detail</h1>
        <p class="text-muted mb-0 font-monospace small">@Model.Id</p>
    </div>
    <span class="badge @badge.CssClass ms-auto fs-6">@badge.Label</span>
</div>

@await Html.PartialAsync("_AlertBanner")

<div class="row g-4">

    <!-- Main info -->
    <div class="col-lg-8">
        <div class="card mb-4">
            <div class="card-header fw-semibold">Payout Information</div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label small text-muted">Seller</label>
                        <div>
                            <a href="/sellers/@Model.SellerId"
                               class="fw-semibold text-decoration-none">
                                @(Model.SellerName ?? Model.SellerId.ToString())
                            </a>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label small text-muted">Amount</label>
                        <div class="fs-4 fw-bold">₹@Model.Amount.ToString("N2")</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Payment details -->
        <div class="card mb-4">
            <div class="card-header fw-semibold">Payment Account Details</div>
            <div class="card-body">
                @if (!string.IsNullOrWhiteSpace(Model.UpiId))
                {
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-phone text-primary fs-5"></i>
                        <div>
                            <div class="small text-muted">UPI ID</div>
                            <div class="fw-semibold">@Model.UpiId</div>
                        </div>
                    </div>
                }
                else if (!string.IsNullOrWhiteSpace(Model.BankAccountNumber))
                {
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label small text-muted">Account Name</label>
                            <div class="fw-semibold">@Model.BankAccountName</div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small text-muted">Account Number</label>
                            <div class="font-monospace">@Model.BankAccountNumber</div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small text-muted">IFSC Code</label>
                            <div class="font-monospace">@Model.BankIfscCode</div>
                        </div>
                    </div>
                }
                else
                {
                    <p class="text-muted mb-0">No payment details provided.</p>
                }
            </div>
        </div>

        <!-- Admin info -->
        @if (!string.IsNullOrWhiteSpace(Model.AdminNote) ||
                !string.IsNullOrWhiteSpace(Model.GatewayReference) ||
                !string.IsNullOrWhiteSpace(Model.FailureReason))
        {
            <div class="card mb-4">
                <div class="card-header fw-semibold">Admin Notes</div>
                <div class="card-body">
                    <div class="row g-3">
                        @if (!string.IsNullOrWhiteSpace(Model.GatewayReference))
                        {
                            <div class="col-12">
                                <label class="form-label small text-muted">
                                    Gateway Reference
                                </label>
                                <div class="font-monospace">@Model.GatewayReference</div>
                            </div>
                        }
                        @if (!string.IsNullOrWhiteSpace(Model.AdminNote))
                        {
                            <div class="col-12">
                                <label class="form-label small text-muted">Admin Note</label>
                                <div>@Model.AdminNote</div>
                            </div>
                        }
                        @if (!string.IsNullOrWhiteSpace(Model.FailureReason))
                        {
                            <div class="col-12">
                                <label class="form-label small text-muted">
                                    Failure / Cancel Reason
                                </label>
                                <div class="text-danger">@Model.FailureReason</div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- Sidebar actions -->
    <div class="col-lg-4">

        <!-- Process action -->
        @if (Model.CanProcess)
        {
            <div class="card mb-3 border-info">
                <div class="card-header fw-semibold bg-info-subtle text-info-emphasis">
                    <i class="bi bi-play-circle me-1"></i> Start Processing
                </div>
                <div class="card-body">
                    <form asp-action="Process" asp-route-id="@Model.Id" method="post">
                        @Html.AntiForgeryToken()
                        <div class="mb-3">
                            <label class="form-label small fw-semibold">
                                Admin Note (optional)
                            </label>
                            <textarea name="adminNote"
                                  class="form-control form-control-sm"
                                  rows="2"
                                  placeholder="Internal note…"></textarea>
                        </div>
                        <button type="submit" class="btn btn-info btn-sm w-100">
                            Mark as Processing
                        </button>
                    </form>
                </div>
            </div>
        }

        <!-- Complete action -->
        @if (Model.CanComplete)
        {
            <div class="card mb-3 border-success">
                <div class="card-header fw-semibold bg-success-subtle text-success-emphasis">
                    <i class="bi bi-check-circle me-1"></i> Complete Payout
                </div>
                <div class="card-body">
                    <form asp-action="Complete" asp-route-id="@Model.Id" method="post">
                        @Html.AntiForgeryToken()
                        <div class="mb-3">
                            <label class="form-label small fw-semibold">
                                Gateway Reference <span class="text-danger">*</span>
                            </label>
                            <input type="text" name="gatewayReference"
                                   class="form-control form-control-sm"
                                   placeholder="NEFT/IMPS/UPI reference…"
                                   required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label small fw-semibold">
                                Admin Note (optional)
                            </label>
                            <input type="text" name="adminNote"
                                   class="form-control form-control-sm" />
                        </div>
                        <button type="submit" class="btn btn-success btn-sm w-100">
                            Mark as Completed
                        </button>
                    </form>
                </div>
            </div>
        }

        <!-- Fail / Cancel -->
        @if (Model.CanFail || Model.CanCancel)
        {
            <div class="card mb-3 border-danger">
                <div class="card-header fw-semibold bg-danger-subtle text-danger-emphasis">
                    <i class="bi bi-x-circle me-1"></i>
                    @(Model.CanFail ? "Mark as Failed" : "Cancel Payout")
                </div>
                <div class="card-body">
                    @if (Model.CanFail)
                    {
                        <form asp-action="Fail" asp-route-id="@Model.Id" method="post"
                              class="mb-2">
                            @Html.AntiForgeryToken()
                            <div class="mb-2">
                                <textarea name="reason"
                                  class="form-control form-control-sm"
                                  rows="2" required
                                  placeholder="Reason for failure…"></textarea>
                            </div>
                            <button type="submit" class="btn btn-danger btn-sm w-100">
                                Mark Failed
                            </button>
                        </form>
                    }
                    @if (Model.CanCancel)
                    {
                        <form asp-action="Cancel" asp-route-id="@Model.Id" method="post">
                            @Html.AntiForgeryToken()
                            <div class="mb-2">
                                <textarea name="reason"
                                  class="form-control form-control-sm"
                                  rows="2" required
                                  placeholder="Reason for cancellation…"></textarea>
                            </div>
                            <button type="submit" class="btn btn-outline-danger btn-sm w-100">
                                Cancel Payout
                            </button>
                        </form>
                    }
                </div>
            </div>
        }

        <!-- Meta -->
        <div class="card">
            <div class="card-header fw-semibold">Timeline</div>
            <div class="card-body">
                <dl class="row mb-0 small">
                    <dt class="col-6 text-muted">Requested</dt>
                    <dd class="col-6">
                        @Model.CreatedAt.ToString("dd MMM yyyy HH:mm")
                    </dd>
                    @if (Model.ProcessedAt.HasValue)
                    {
                        <dt class="col-6 text-muted">Processing</dt>
                        <dd class="col-6">
                            @Model.ProcessedAt.Value.ToString("dd MMM yyyy HH:mm")
                        </dd>
                    }
                    @if (Model.CompletedAt.HasValue)
                    {
                        <dt class="col-6 text-muted">Completed</dt>
                        <dd class="col-6 text-success fw-semibold">
                            @Model.CompletedAt.Value.ToString("dd MMM yyyy HH:mm")
                        </dd>
                    }
                    @if (Model.FailedAt.HasValue)
                    {
                        <dt class="col-6 text-muted">Failed</dt>
                        <dd class="col-6 text-danger">
                            @Model.FailedAt.Value.ToString("dd MMM yyyy HH:mm")
                        </dd>
                    }
                    @if (Model.CancelledAt.HasValue)
                    {
                        <dt class="col-6 text-muted">Cancelled</dt>
                        <dd class="col-6 text-secondary">
                            @Model.CancelledAt.Value.ToString("dd MMM yyyy HH:mm")
                        </dd>
                    }
                </dl>
            </div>
        </div>

    </div>
</div>
