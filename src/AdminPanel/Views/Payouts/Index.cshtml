@using AdminPanel.Helpers
@using AdminPanel.ViewModels.Common
@using AdminPanel.ViewModels.Payments
@model PayoutIndexViewModel
@{
    ViewData["Title"] = "Payouts";
}

<div class="pg-bar">
    <div>
        <h1 class="pg-title">Payouts</h1>
        <p class="pg-sub">Seller payout requests and history</p>
    </div>
</div>

<partial name="_AlertBanner" />

<div class="card">
    <form method="get" class="filter-bar">

        <select name="status" class="filter-select">
            <option value="">All Statuses</option>
            @foreach (var opt in Model.StatusOptions)
            {
                <option value="@opt.Value"
                        selected="@(Model.StatusFilter == opt.Value)">
                    @opt.Label
                </option>
            }
        </select>

        <div class="filter-search">
            <svg class="filter-search-ico" width="14" height="14" fill="none"
                 viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <circle cx="11" cy="11" r="8" />
                <line x1="21" y1="21" x2="16.65" y2="16.65" />
            </svg>
            <input type="text" name="search" class="filter-input"
                   placeholder="Seller name…" value="@Model.Search" />
        </div>

        <div class="f-right">
            <button type="submit" class="btn btn-outline btn-sm">Filter</button>
            @if (!string.IsNullOrEmpty(Model.Search) || !string.IsNullOrEmpty(Model.StatusFilter))
            {
                <a asp-action="Index" class="btn btn-ghost btn-sm">Clear</a>
            }
        </div>
    </form>

    @if (!Model.Items.Any())
    {
        <partial name="_EmptyState" model="@(new EmptyStateModel
                                    {
                                        Title = "No payouts found",
                                        Message = "No payout requests match your filters."
                                    })" />
        }
    else
    {
        <div class="tbl-wrap">
            <table>
                <thead>
                    <tr>
                        <th>Seller</th>
                        <th>Amount</th>
                        <th>Payment Method</th>
                        <th style="width:120px">Status</th>
                        <th style="width:120px">Requested</th>
                        <th style="width:120px">Completed</th>
                        <th style="text-align:center;width:80px">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Items)
                    {
                        <tr>
                            <td class="prod-name">
                                @(item.SellerName ?? item.SellerId.ToString()[..8] + "…")
                            </td>
                            <td class="price">₹@item.Amount.ToString("N2")</td>
                            <td class="tbl-meta">@(item.PaymentMethod ?? "—")</td>
                            <td>
                                @{
                                    var pBadge = BadgeHelper.Payout(item.Status);
                                }
                                <span class="badge @pBadge.CssClass">@pBadge.Label</span>
                            </td>
                            <td class="tbl-date">@item.CreatedAt.ToString("dd MMM yyyy")</td>
                            <td class="tbl-date">
                                @(item.CompletedAt?.ToString("dd MMM yyyy") ?? "—")
                            </td>
                            <td style="text-align:center">
                                <a asp-action="Detail" asp-route-id="@item.Id"
                                   class="row-btn" title="View">
                                    <svg width="14" height="14" fill="none" viewBox="0 0 24 24"
                                         stroke="currentColor" stroke-width="2">
                                        <path stroke-linecap="round" stroke-linejoin="round"
                                              d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                                        <path stroke-linecap="round" stroke-linejoin="round"
                                              d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943
                                                         9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                                    </svg>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <partial name="_Pagination" model="@(new PaginationViewModel
                                    {
                                        Page = Model.Page,
                                        PageSize = Model.PageSize,
                                        TotalCount = Model.TotalCount,
                                        RouteData = Model.RouteData,
                                        Action = "Index",
                                        Controller = "Payouts"
                                    })" />
        }
</div>