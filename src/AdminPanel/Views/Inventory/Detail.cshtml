@using AdminPanel.ViewModels.Inventory
@model StockDetailViewModel
@{
    ViewData["Title"] = "Manage Stock";
    var statusBadge = Model.Status switch
    {
        "InStock" => "badge b-active",
        "LowStock" => "badge b-pending",
        "OutOfStock" => "badge b-rejected",
        _ => "badge badge-gray"
    };
    var statusLabel = Model.Status switch
    {
        "InStock" => "In Stock",
        "LowStock" => "Low Stock",
        "OutOfStock" => "Out of Stock",
        _ => Model.Status
    };
}

<div class="pg-bar">
    <div>
        <div class="pg-eyebrow">
            <a asp-action="Index">Inventory</a>
            <span class="pg-eyebrow-sep">›</span>
            <span>@(Model.ProductName ?? "Product")</span>
        </div>
        <h1 class="pg-title">
            @(string.IsNullOrEmpty(Model.ProductName)
                        ? "Stock Management"
                        : Model.ProductName)
        </h1>
        <p class="pg-sub">
            @if (!string.IsNullOrEmpty(Model.VariantName))
            {
                <span>Variant: @Model.VariantName ·</span>
            }
            <span class="@statusBadge">@statusLabel</span>
        </p>
    </div>
    <div class="pg-actions">
        <a asp-action="Index" class="btn btn-outline btn-sm">← Back</a>
        <a asp-controller="Products" asp-action="Detail"
           asp-route-id="@Model.ProductId"
           class="btn btn-outline btn-sm">View Product</a>
    </div>
</div>

<partial name="_AlertBanner" />

@if (Model.IsLowStock)
{
    <div class="alert alert-amber">
        <div class="alert-icon">⚠</div>
        <div class="alert-body">
            <div class="alert-title">Low stock alert</div>
            <div class="alert-desc">
                Available quantity (@Model.AvailableQuantity) is at or below
                the threshold (@Model.LowStockThreshold). Restock soon.
            </div>
        </div>
    </div>
}

@if (Model.AvailableQuantity == 0 && Model.Status == "OutOfStock")
{
    <div class="alert alert-rose">
        <div class="alert-icon">✕</div>
        <div class="alert-body">
            <div class="alert-title">Out of stock</div>
            <div class="alert-desc">
                This product is currently out of stock and cannot be purchased.
            </div>
        </div>
    </div>
}

<div class="detail-grid">

    <div class="detail-main">

        <!-- Stock levels card -->
        <div class="card">
            <div class="card-head">
                <div class="card-title">Current Stock Levels</div>
            </div>
            <div class="card-body">
                <div class="stats-grid" style="grid-template-columns:repeat(3,1fr);gap:12px">

                    <div style="background:var(--c-canvas);border:1px solid var(--c-border);
                                border-radius:var(--r-lg);padding:18px;text-align:center">
                        @{
                            var availColor = Model.AvailableQuantity == 0
                            ? "var(--c-rose)"
                            : Model.IsLowStock
                            ? "var(--c-amber)"
                            : "var(--c-emerald)";
                        }
                        <div style="font-family:var(--f-display);font-size:36px;
                                    font-weight:800;letter-spacing:-2px;
                                    color:@availColor">
                            @Model.AvailableQuantity
                        </div>
                        <div style="font-size:12px;color:var(--c-ink-3);margin-top:4px;font-weight:600">
                            Available
                        </div>
                    </div>

                    <div style="background:var(--c-canvas);border:1px solid var(--c-border);
                                border-radius:var(--r-lg);padding:18px;text-align:center">
                        <div style="font-family:var(--f-display);font-size:36px;
                                    font-weight:800;letter-spacing:-2px;color:var(--c-amber)">
                            @Model.ReservedQuantity
                        </div>
                        <div style="font-size:12px;color:var(--c-ink-3);margin-top:4px;font-weight:600">
                            Reserved
                        </div>
                    </div>

                    <div style="background:var(--c-canvas);border:1px solid var(--c-border);
                                border-radius:var(--r-lg);padding:18px;text-align:center">
                        <div style="font-family:var(--f-display);font-size:36px;
                                    font-weight:800;letter-spacing:-2px;color:var(--c-ink)">
                            @Model.Quantity
                        </div>
                        <div style="font-size:12px;color:var(--c-ink-3);margin-top:4px;font-weight:600">
                            Total
                        </div>
                    </div>

                </div>
            </div>
        </div>

        <!-- Add stock form -->
        <div class="card">
            <div class="card-head">
                <div class="card-title">Add Stock</div>
                <span class="card-sub">Increases total quantity</span>
            </div>
            <div class="card-body">
                <form asp-action="AddStock" asp-route-productId="@Model.ProductId"
                      method="post">
                    @Html.AntiForgeryToken()
                    <div class="field-grid-2">
                        <div class="form-group">
                            <label class="form-label">
                                Quantity to Add <span>*</span>
                            </label>
                            <input type="number" name="quantity"
                                   class="form-input" min="1"
                                   placeholder="e.g. 50" required />
                        </div>
                        <div class="form-group">
                            <label class="form-label">Note</label>
                            <input type="text" name="note"
                                   class="form-input"
                                   placeholder="e.g. Restocked from supplier" />
                        </div>
                    </div>
                    <div class="form-actions" style="padding-top:0">
                        <button type="submit" class="btn btn-primary btn-sm">
                            <svg width="13" height="13" fill="none"
                                 viewBox="0 0 24 24" stroke="currentColor"
                                 stroke-width="2.5">
                                <line x1="12" y1="5" x2="12" y2="19" />
                                <line x1="5" y1="12" x2="19" y2="12" />
                            </svg>
                            Add Stock
                        </button>
                    </div>
                </form>
            </div>
        </div>

        <!-- Set quantity form -->
        <div class="card">
            <div class="card-head">
                <div class="card-title">Set Exact Quantity</div>
                <span class="card-sub">Overrides current total</span>
            </div>
            <div class="card-body">
                <form asp-action="SetQuantity" asp-route-productId="@Model.ProductId"
                      method="post">
                    @Html.AntiForgeryToken()
                    <div class="field-grid-2">
                        <div class="form-group">
                            <label class="form-label">New Total Quantity <span>*</span></label>
                            <input type="number" name="quantity"
                                   class="form-input" min="0"
                                   value="@Model.Quantity" required />
                        </div>
                        <div class="form-group">
                            <label class="form-label">Note</label>
                            <input type="text" name="note"
                                   class="form-input"
                                   placeholder="e.g. Manual correction" />
                        </div>
                    </div>
                    <div class="form-actions" style="padding-top:0">
                        <button type="submit" class="btn btn-outline btn-sm">
                            Set Quantity
                        </button>
                    </div>
                </form>
            </div>
        </div>

    </div>

    <div class="detail-side">

        <!-- Summary card -->
        <div class="card">
            <div class="card-head"><div class="card-title">Summary</div></div>
            <div class="card-body">
                <div class="detail-kv">
                    <span class="detail-k">Status</span>
                    <span class="detail-v">
                        <span class="@statusBadge">@statusLabel</span>
                    </span>
                </div>
                <div class="detail-kv">
                    <span class="detail-k">Available</span>
                    <span class="detail-v tbl-mono" style="font-weight:700">
                        @Model.AvailableQuantity
                    </span>
                </div>
                <div class="detail-kv">
                    <span class="detail-k">Reserved</span>
                    <span class="detail-v tbl-mono">@Model.ReservedQuantity</span>
                </div>
                <div class="detail-kv">
                    <span class="detail-k">Total</span>
                    <span class="detail-v tbl-mono">@Model.Quantity</span>
                </div>
                <div class="detail-kv">
                    <span class="detail-k">Low Stock At</span>
                    <span class="detail-v tbl-mono">@Model.LowStockThreshold</span>
                </div>
                <div class="detail-kv">
                    <span class="detail-k">Track Inventory</span>
                    <span class="detail-v">
                        <span class="badge @(Model.TrackInventory ? "b-active" : "badge-gray")">
                            @(Model.TrackInventory ? "Yes" : "No")
                        </span>
                    </span>
                </div>
                <div class="detail-kv">
                    <span class="detail-k">Allow Backorder</span>
                    <span class="detail-v">
                        <span class="badge @(Model.AllowBackorder ? "b-active" : "badge-gray")">
                            @(Model.AllowBackorder ? "Yes" : "No")
                        </span>
                    </span>
                </div>
                <div class="detail-kv">
                    <span class="detail-k">Last Updated</span>
                    <span class="detail-v tbl-date">
                        @Model.UpdatedAt.ToString("dd MMM yyyy")
                    </span>
                </div>
            </div>
        </div>

        <!-- Settings card -->
        <div class="card">
            <div class="card-head">
                <div class="card-title">Settings</div>
            </div>
            <div class="card-body">
                <form asp-action="UpdateSettings"
                      asp-route-productId="@Model.ProductId"
                      method="post">
                    @Html.AntiForgeryToken()

                    <div class="form-group" style="margin-bottom:14px">
                        <label class="form-label">
                            Low Stock Threshold
                        </label>
                        <input type="number" name="newLowStockThreshold"
                               class="form-input"
                               value="@Model.LowStockThreshold"
                               min="0" />
                        <span class="form-hint">
                            Alert when available drops to or below this number
                        </span>
                    </div>

                    <div class="form-group" style="margin-bottom:14px">
                        <label class="form-label">Track Inventory</label>
                        <label class="check-row">
                            @{
                                var trackChecked = Model.TrackInventory;
                            }
                            @if (trackChecked)
                            {
                                <input type="checkbox" name="newTrackInventory"
                                       value="true" class="cb" checked />
                            }
                            else
                            {
                                <input type="checkbox" name="newTrackInventory"
                                       value="true" class="cb" />
                            }
                            <span class="check-row-label">
                                Track stock levels
                                <span class="check-row-hint">
                                    Uncheck for unlimited/service products
                                </span>
                            </span>
                        </label>
                    </div>

                    <div class="form-group" style="margin-bottom:16px">
                        <label class="form-label">Allow Backorder</label>
                        <label class="check-row">
                            @{
                                var backorderChecked = Model.AllowBackorder;
                            }
                            @if (backorderChecked)
                            {
                                <input type="checkbox" name="newAllowBackorder"
                                       value="true" class="cb" checked />
                            }
                            else
                            {
                                <input type="checkbox" name="newAllowBackorder"
                                       value="true" class="cb" />
                            }
                            <span class="check-row-label">
                                Allow out-of-stock orders
                                <span class="check-row-hint">
                                    Buyers can purchase even when unavailable
                                </span>
                            </span>
                        </label>
                    </div>

                    <button type="submit" class="btn btn-primary btn-sm"
                            style="width:100%;justify-content:center">
                        Save Settings
                    </button>
                </form>
            </div>
        </div>

    </div>
</div>