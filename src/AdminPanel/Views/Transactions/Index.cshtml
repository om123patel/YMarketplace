@using AdminPanel.Helpers
@using AdminPanel.ViewModels.Common
@using AdminPanel.ViewModels.Payments
@model TransactionIndexViewModel
@{
    ViewData["Title"] = "Transactions";
}

<div class="pg-bar">
    <div>
        <h1 class="pg-title">Transactions</h1>
        <p class="pg-sub">All payment transactions across the platform</p>
    </div>
</div>

<partial name="_AlertBanner" />

<div class="card">
    <form method="get" class="filter-bar">

        <select name="status" class="filter-select">
            <option value="">All Statuses</option>
            @foreach (var opt in Model.StatusOptions)
            {
                <option value="@opt.Value"
                        selected="@(Model.StatusFilter == opt.Value)">
                    @opt.Label
                </option>
            }
        </select>

        <select name="method" class="filter-select">
            <option value="">All Methods</option>
            @foreach (var opt in Model.MethodOptions)
            {
                <option value="@opt.Value"
                        selected="@(Model.MethodFilter == opt.Value)">
                    @opt.Label
                </option>
            }
        </select>

        <input type="date" name="dateFrom" class="filter-input"
               style="max-width:160px" value="@Model.DateFromFilter" />
        <input type="date" name="dateTo" class="filter-input"
               style="max-width:160px" value="@Model.DateToFilter" />

        <div class="filter-search">
            <svg class="filter-search-ico" width="14" height="14" fill="none"
                 viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <circle cx="11" cy="11" r="8"/>
                <line x1="21" y1="21" x2="16.65" y2="16.65"/>
            </svg>
            <input type="text" name="search" class="filter-input"
                   placeholder="Gateway ID…" value="@Model.Search"/>
        </div>

        <div class="f-right">
            <button type="submit" class="btn btn-outline btn-sm">Filter</button>
            @if (!string.IsNullOrEmpty(Model.Search) || !string.IsNullOrEmpty(Model.StatusFilter)
                 || !string.IsNullOrEmpty(Model.MethodFilter))
            {
                <a asp-action="Index" class="btn btn-ghost btn-sm">Clear</a>
            }
        </div>
    </form>

    @if (!Model.Items.Any())
    {
        <partial name="_EmptyState" model="@(new EmptyStateModel
        {
            Title = "No transactions found",
            Message = "Try adjusting your filters."
        })" />
    }
    else
    {
        <div class="tbl-wrap">
            <table>
                <thead>
                    <tr>
                        <th>Order</th>
                        <th>Amount</th>
                        <th>Commission</th>
                        <th>Seller Net</th>
                        <th>Method</th>
                        <th>Status</th>
                        <th>Gateway Ref</th>
                        <th>Date</th>
                        <th style="text-align:center;width:80px">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Items)
                    {
                        <tr>
                            <td>
                                <a asp-controller="Orders" asp-action="Detail"
                                   asp-route-id="@item.OrderId"
                                   class="tbl-link tbl-mono"
                                   style="font-size:12px">
                                    @item.OrderId.ToString()[..8]…
                                </a>
                            </td>
                            <td class="price">₹@item.Amount.ToString("N2")</td>
                            <td class="tbl-meta">₹@item.CommissionAmount.ToString("N2")</td>
                            <td style="color:var(--c-emerald);font-weight:600">
                                ₹@item.SellerAmount.ToString("N2")
                            </td>
                            <td>
                                <span class="badge badge-gray">@item.Method</span>
                            </td>
                            <td>
                                @{ var txBadge = BadgeHelper.Transaction(item.Status); }
                                <span class="badge @txBadge.CssClass">@txBadge.Label</span>
                            </td>
                            <td class="tbl-mono" style="font-size:12px;color:var(--c-ink-4)">
                                @(item.GatewayTransactionId ?? "—")
                            </td>
                            <td class="tbl-date">@item.CreatedAt.ToString("dd MMM yyyy")</td>
                            <td style="text-align:center">
                                <a asp-action="Detail" asp-route-id="@item.Id"
                                   class="row-btn" title="View">
                                    <svg width="14" height="14" fill="none" viewBox="0 0 24 24"
                                         stroke="currentColor" stroke-width="2">
                                        <path stroke-linecap="round" stroke-linejoin="round"
                                              d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                                        <path stroke-linecap="round" stroke-linejoin="round"
                                              d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943
                                                 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
                                    </svg>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <partial name="_Pagination" model="@(new PaginationViewModel
        {
            Page = Model.Page,
            PageSize = Model.PageSize,
            TotalCount = Model.TotalCount,
            RouteData = Model.RouteData,
            Action = "Index",
            Controller = "Transactions"
        })" />
    }
</div>