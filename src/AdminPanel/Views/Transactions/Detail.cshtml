@* src/AdminPanel/Views/Transactions/Detail.cshtml *@
@using AdminPanel.Helpers
@using AdminPanel.ViewModels.Payments
@model TransactionDetailViewModel
@{
    ViewData["Title"] = "Transaction Detail";
    var badge = BadgeHelper.Transaction(Model.Status);
}

<div class="pg-bar">
    <div>
        <div class="pg-eyebrow">
            <a asp-action="Index">Transactions</a>
            <span class="pg-eyebrow-sep">›</span>
            <span>Detail</span>
        </div>
        <h1 class="pg-title">Transaction</h1>
        <p class="pg-sub">
            <span class="tbl-mono" style="font-size:13px">
                @Model.Id.ToString()[..8]…
            </span>
            · <span class="badge @badge.CssClass">@badge.Label</span>
        </p>
    </div>
    <div class="pg-actions">
        <a asp-action="Index" class="btn btn-outline btn-sm">← Back</a>
    </div>
</div>

<partial name="_AlertBanner" />

<div class="detail-grid">

    <div class="detail-main">

        <div class="card">
            <div class="card-head"><div class="card-title">Payment Details</div></div>
            <div class="card-body">
                <div class="field-grid-2">
                    <div class="form-group">
                        <label class="form-label">Order</label>
                        <div style="padding:9px 0">
                            <a asp-controller="Orders" asp-action="Detail"
                               asp-route-id="@Model.OrderId"
                               class="tbl-link tbl-mono" style="font-size:12px">
                                @Model.OrderId
                            </a>
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Payment Method</label>
                        <div style="padding:9px 0">
                            <span class="badge badge-gray">@Model.Method</span>
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Total Amount</label>
                        <div class="price" style="padding:9px 0;font-size:20px">
                            ₹@Model.Amount.ToString("N2")
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Platform Commission</label>
                        <div style="padding:9px 0;font-size:14px;
                                    color:var(--c-rose);font-weight:600">
                            − ₹@Model.CommissionAmount.ToString("N2")
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Seller Net</label>
                        <div style="padding:9px 0;font-size:18px;
                                    color:var(--c-emerald);font-weight:700">
                            ₹@Model.SellerAmount.ToString("N2")
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Gateway Provider</label>
                        <div style="font-size:13.5px;color:var(--c-ink);padding:9px 0">
                            @(Model.GatewayProvider ?? "—")
                        </div>
                    </div>
                </div>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(Model.GatewayTransactionId))
        {
            <div class="card">
                <div class="card-head">
                    <div class="card-title">Gateway Reference</div>
                </div>
                <div class="card-body">
                    <div class="detail-kv">
                        <span class="detail-k">Transaction ID</span>
                        <span class="detail-v tbl-mono">
                            @Model.GatewayTransactionId
                        </span>
                    </div>
                    @if (Model.CompletedAt.HasValue)
                    {
                        <div class="detail-kv">
                            <span class="detail-k">Completed At</span>
                            <span class="detail-v tbl-date">
                                @Model.CompletedAt.Value.ToString("dd MMM yyyy, HH:mm") UTC
                            </span>
                        </div>
                    }
                    @if (Model.FailedAt.HasValue)
                    {
                        <div class="detail-kv">
                            <span class="detail-k">Failed At</span>
                            <span class="detail-v" style="color:var(--c-rose)">
                                @Model.FailedAt.Value.ToString("dd MMM yyyy, HH:mm") UTC
                            </span>
                        </div>
                    }
                </div>
            </div>
        }

        @if (Model.RefundedAmount > 0)
        {
            <div class="card" style="border-color:#fcd34d">
                <div class="card-head"
                     style="background:var(--c-amber-lt);border-color:#fcd34d">
                    <div class="card-title" style="color:var(--c-amber)">
                        Refund Details
                    </div>
                </div>
                <div class="card-body">
                    <div class="field-grid-2">
                        <div>
                            <label class="form-label">Refunded Amount</label>
                            <div style="font-size:18px;font-weight:700;
                                            color:var(--c-amber);padding:9px 0">
                                ₹@Model.RefundedAmount.ToString("N2")
                            </div>
                        </div>
                        <div>
                            <label class="form-label">Refunded At</label>
                            <div style="font-size:13.5px;color:var(--c-ink);padding:9px 0">
                                @(Model.RefundedAt?.ToString("dd MMM yyyy, HH:mm") ?? "—")
                            </div>
                        </div>
                        @if (!string.IsNullOrEmpty(Model.RefundReason))
                        {
                            <div style="grid-column:1/-1">
                                <label class="form-label">Reason</label>
                                <div style="font-size:13.5px;color:var(--c-ink-2);padding:9px 0">
                                    @Model.RefundReason
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }

    </div>

    <div class="detail-side">

        <div class="card">
            <div class="card-head"><div class="card-title">Summary</div></div>
            <div class="card-body">
                <div class="detail-kv">
                    <span class="detail-k">Status</span>
                    <span class="detail-v">
                        <span class="badge @badge.CssClass">@badge.Label</span>
                    </span>
                </div>
                <div class="detail-kv">
                    <span class="detail-k">Amount</span>
                    <span class="detail-v tbl-mono" style="font-weight:700">
                        ₹@Model.Amount.ToString("N2")
                    </span>
                </div>
                <div class="detail-kv">
                    <span class="detail-k">Seller ID</span>
                    <span class="detail-v tbl-mono" style="font-size:11px">
                        @Model.SellerId.ToString()[..8]…
                    </span>
                </div>
                <div class="detail-kv">
                    <span class="detail-k">Created</span>
                    <span class="detail-v tbl-date">
                        @Model.CreatedAt.ToString("dd MMM yyyy")
                    </span>
                </div>
                <div class="detail-kv">
                    <span class="detail-k">Updated</span>
                    <span class="detail-v tbl-date">
                        @Model.UpdatedAt.ToString("dd MMM yyyy")
                    </span>
                </div>
            </div>
        </div>

        @if (Model.CanRefund)
        {
            <div class="card" style="border-color:#fcd34d">
                <div class="card-head"
                     style="background:var(--c-amber-lt);border-color:#fcd34d">
                    <div class="card-title" style="color:var(--c-amber)">
                        Issue Refund
                    </div>
                </div>
                <div class="card-body">
                    <p style="font-size:12.5px;color:var(--c-ink-3);margin-bottom:12px">
                        Remaining refundable:
                        <strong style="color:var(--c-ink)">
                            ₹@Model.MaxRefundable.ToString("N2")
                        </strong>
                    </p>
                    <form asp-action="Refund" asp-route-id="@Model.Id" method="post">
                        @Html.AntiForgeryToken()
                        <div class="form-group" style="margin-bottom:12px">
                            <label class="form-label">
                                Amount (₹) <span>*</span>
                            </label>
                            <input type="number" name="amount" class="form-input"
                                   step="0.01" min="0.01" max="@Model.MaxRefundable"
                                   value="@Model.MaxRefundable" required />
                        </div>
                        <div class="form-group" style="margin-bottom:12px">
                            <label class="form-label">Reason <span>*</span></label>
                            <textarea name="reason" class="form-textarea" rows="2"
                                  placeholder="Reason for refund…" required></textarea>
                        </div>
                        <button type="submit" class="btn btn-outline btn-sm"
                                style="width:100%;justify-content:center">
                            Process Refund
                        </button>
                    </form>
                </div>
            </div>
        }

    </div>
</div>