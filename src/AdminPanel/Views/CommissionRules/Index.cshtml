@using AdminPanel.ViewModels.Payments
@model CommissionRuleIndexViewModel
@{
    ViewData["Title"] = "Commission Rules";
    Layout = "_AdminLayout";
}

<div class="page-header d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-0">Commission Rules</h1>
        <p class="text-muted mb-0">
            Platform commission rates applied per product category.
            The <strong>Global Default</strong> applies when no category-specific rule exists.
        </p>
    </div>
    <button class="btn btn-primary"
            data-bs-toggle="modal" data-bs-target="#createRuleModal">
        <i class="bi bi-plus-lg me-1"></i> Add Rule
    </button>
</div>

@await Html.PartialAsync("_AlertBanner")

<!-- Rules Table -->
<div class="card">
    <div class="card-body p-0">
        @if (!Model.Rules.Any())
        {
            @await Html.PartialAsync("_EmptyState", new EmptyStateModel
            {
                Title = "No commission rules",
                Message = "Create a Global Default rule to start applying commissions."

                })
                }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Rule Name</th>
                            <th>Category</th>
                            <th>Rate</th>
                            <th>Status</th>
                            <th>Last Updated</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var rule in Model.Rules)
                        {
                            <tr>
                                <td class="fw-semibold">
                                    @rule.Name
                                    @if (rule.CategoryId is null)
                                    {
                                        <span class="badge bg-primary ms-1">Default</span>
                                    }
                            </td>
                            <td class="text-muted">
                                @(rule.CategoryName ?? (rule.CategoryId.HasValue
                                                            ? $"Category #{rule.CategoryId}"
                                                            : "All Categories"))
                        </td>
                        <td>
                            <span class="fs-6 fw-bold text-primary">
                                @rule.RatePercent.ToString("0.##")%
                            </span>
                        </td>
                        <td>
                            @if (rule.IsActive)
                                    {
                                        <span class="badge bg-success-subtle text-success-emphasis border border-success-subtle">
                                            Active
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary-emphasis border">
                                            Inactive
                                        </span>
                                    }
                                </td>
                                <td class="small text-muted">
                                    @rule.UpdatedAt.ToString("dd MMM yyyy")
                                </td>
                                <td class="text-end">
                                    <div class="d-flex gap-1 justify-content-end">
                                        <!-- Edit -->
                                        <button class="btn btn-sm btn-outline-secondary"
                                                data-bs-toggle="modal"
                                                data-bs-target="#editModal-@rule.Id">
                                            <i class="bi bi-pencil"></i>
                                        </button>

                                        <!-- Activate / Deactivate -->
                                        @if (rule.IsActive)
                                        {
                                            <form asp-action="Deactivate"
                                                  asp-route-id="@rule.Id"
                                                  method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <button type="submit"
                                                        class="btn btn-sm btn-outline-warning"
                                                        title="Deactivate">
                                                    <i class="bi bi-pause"></i>
                                                </button>
                                            </form>
                                        }
                                        else
                                        {
                                            <form asp-action="Activate"
                                                  asp-route-id="@rule.Id"
                                                  method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <button type="submit"
                                                        class="btn btn-sm btn-outline-success"
                                                        title="Activate">
                                                    <i class="bi bi-play"></i>
                                                </button>
                                            </form>
                                        }

                                        <!-- Delete -->
                                        <form asp-action="Delete"
                                              asp-route-id="@rule.Id"
                                              method="post" class="d-inline"
                                              onsubmit="return confirm('Delete this rule?')">
                                            @Html.AntiForgeryToken()
                                            <button type="submit"
                                                    class="btn btn-sm btn-outline-danger"
                                                    title="Delete">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>

                            <!-- Edit Modal per rule -->
                            <div class="modal fade" id="editModal-@rule.Id"
                                 tabindex="-1" aria-hidden="true">
                                <div class="modal-dialog">
                                    <div class="modal-content">
                                        <div class="modal-header">
                                            <h5 class="modal-title">
                                                Edit Rule — @rule.Name
                                            </h5>
                                            <button type="button" class="btn-close"
                                                    data-bs-dismiss="modal"></button>
                                        </div>
                                        <form asp-action="Edit"
                                              asp-route-id="@rule.Id"
                                              method="post">
                                            @Html.AntiForgeryToken()
                                            <div class="modal-body">
                                                <div class="mb-3">
                                                    <label class="form-label">Rule Name</label>
                                                    <input type="text" name="name"
                                                           class="form-control"
                                                           value="@rule.EditName" required />
                                                </div>
                                                <div class="mb-3">
                                                    <label class="form-label">
                                                        Category ID
                                                        <span class="text-muted small">
                                                            (leave blank for global default)
                                                        </span>
                                                    </label>
                                                    <input type="number" name="categoryId"
                                                           class="form-control"
                                                           value="@rule.EditCategoryId" />
                                                </div>
                                                <div class="mb-3">
                                                    <label class="form-label">
                                                        Rate (%)
                                                    </label>
                                                    <div class="input-group">
                                                        <input type="number"
                                                               name="ratePercent"
                                                               class="form-control"
                                                               step="0.01" min="0" max="100"
                                                               value="@rule.EditRatePercent"
                                                               required />
                                                        <span class="input-group-text">%</span>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="modal-footer">
                                                <button type="button"
                                                        class="btn btn-secondary"
                                                        data-bs-dismiss="modal">
                                                    Cancel
                                                </button>
                                                <button type="submit"
                                                        class="btn btn-primary">
                                                    Save Changes
                                                </button>
                                            </div>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

<!-- Create Modal -->
<div class="modal fade" id="createRuleModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Add Commission Rule</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Rule Name</label>
                        <input type="text" name="NewName" class="form-control"
                               placeholder="e.g. Electronics" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">
                            Category ID
                            <span class="text-muted small">
                                (leave blank for global default)
                            </span>
                        </label>
                        <input type="number" name="NewCategoryId"
                               class="form-control" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Rate (%)</label>
                        <div class="input-group">
                            <input type="number" name="NewRatePercent"
                                   class="form-control"
                                   step="0.01" min="0" max="100"
                                   placeholder="10.00" required />
                            <span class="input-group-text">%</span>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary"
                            data-bs-dismiss="modal">
                        Cancel
                    </button>
                    <button type="submit" class="btn btn-primary">Create Rule</button>
                </div>
            </form>
        </div>
    </div>
</div>