@* src/AdminPanel/Views/CommissionRules/Index.cshtml *@
@using AdminPanel.Helpers
@using AdminPanel.ViewModels.Common
@using AdminPanel.ViewModels.Payments
@model CommissionRuleIndexViewModel
@{
    ViewData["Title"] = "Commission Rules";
}

<div class="pg-bar">
    <div>
        <h1 class="pg-title">Commission Rules</h1>
        <p class="pg-sub">
            Platform commission rates by category.
            The Global Default applies when no category-specific rule exists.
        </p>
    </div>
    <div class="pg-actions">
        <button type="button" class="btn btn-primary"
                onclick="document.getElementById('createPanel').style.display='block'">
            <svg width="13" height="13" fill="none" viewBox="0 0 24 24"
                 stroke="currentColor" stroke-width="2.5">
                <line x1="12" y1="5" x2="12" y2="19"/>
                <line x1="5" y1="12" x2="19" y2="12"/>
            </svg>
            Add Rule
        </button>
    </div>
</div>

<partial name="_AlertBanner" />

@* Create form (inline panel) *@
<div id="createPanel" style="display:none">
    <div class="card" style="border-color:#c7d2fe">
        <div class="card-head"
             style="background:var(--c-indigo-lt);border-color:#c7d2fe">
            <div class="card-title" style="color:var(--c-indigo)">
                New Commission Rule
            </div>
        </div>
        <div class="card-body">
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <div class="field-grid-2" style="margin-bottom:16px">
                    <div class="form-group">
                        <label class="form-label">Rule Name <span>*</span></label>
                        <input type="text" name="NewName" class="form-input"
                               asp-for="NewName"
                               placeholder="e.g. Electronics" required />
                    </div>
                    <div class="form-group">
                        <label class="form-label">
                            Category ID
                            <span class="form-hint" style="display:inline">
                                — blank = global default
                            </span>
                        </label>
                        <input type="number" name="NewCategoryId"
                               asp-for="NewCategoryId" class="form-input" />
                    </div>
                    <div class="form-group">
                        <label class="form-label">Rate (%) <span>*</span></label>
                        <input type="number" name="NewRatePercent"
                               asp-for="NewRatePercent"
                               class="form-input" step="0.01" min="0" max="100"
                               placeholder="10.00" required />
                    </div>
                </div>
                <div class="form-actions">
                    <button type="button" class="btn btn-ghost btn-sm"
                            onclick="document.getElementById('createPanel').style.display='none'">
                        Cancel
                    </button>
                    <button type="submit" class="btn btn-primary btn-sm">
                        Create Rule
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="card">

    @if (!Model.Rules.Any())
    {
        <partial name="_EmptyState" model="@(new EmptyStateModel
        {
            Title = "No commission rules",
            Message = "Create a Global Default rule to start applying commissions.",
            ActionLabel = "Add Rule",
            ActionHref = "#"
        })" />
    }
    else
    {
        <div class="tbl-wrap">
            <table>
                <thead>
                    <tr>
                        <th>Rule Name</th>
                        <th>Category</th>
                        <th>Rate</th>
                        <th style="width:110px">Status</th>
                        <th style="width:120px">Last Updated</th>
                        <th style="text-align:center;width:140px">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var rule in Model.Rules)
                    {
                        <tr>
                            <td>
                                <div class="prod-name">
                                    @rule.Name
                                    @if (rule.CategoryId is null)
                                    {
                                        <span class="badge badge-indigo"
                                              style="margin-left:6px">
                                            Default
                                        </span>
                                    }
                                </div>
                            </td>
                            <td class="tbl-meta">
                                @(rule.CategoryName
                                    ?? (rule.CategoryId.HasValue
                                        ? $"Category #{rule.CategoryId}"
                                        : "All Categories"))
                            </td>
                            <td>
                                <span class="price" style="font-size:15px">
                                    @rule.RatePercent.ToString("0.##")%
                                </span>
                            </td>
                            <td>
                                <span class="badge @(rule.IsActive ? "b-active" : "badge-gray")">
                                    @(rule.IsActive ? "Active" : "Inactive")
                                </span>
                            </td>
                            <td class="tbl-date">
                                @rule.UpdatedAt.ToString("dd MMM yyyy")
                            </td>
                            <td>
                                <div class="row-acts">

                                    @* Edit button — opens inline edit panel *@
                                    <button type="button" class="row-btn"
                                            title="Edit"
                                            onclick="openEdit('@rule.Id')">
                                        <svg width="14" height="14" fill="none"
                                             viewBox="0 0 24 24" stroke="currentColor"
                                             stroke-width="2">
                                            <path stroke-linecap="round"
                                                  stroke-linejoin="round"
                                                  d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
                                        </svg>
                                    </button>

                                    @if (rule.IsActive)
                                    {
                                        <form asp-action="Deactivate"
                                              asp-route-id="@rule.Id" method="post">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="row-btn"
                                                    title="Deactivate">
                                                <svg width="14" height="14" fill="none"
                                                     viewBox="0 0 24 24"
                                                     stroke="currentColor" stroke-width="2">
                                                    <rect x="6" y="4" width="4" height="16"/>
                                                    <rect x="14" y="4" width="4" height="16"/>
                                                </svg>
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <form asp-action="Activate"
                                              asp-route-id="@rule.Id" method="post">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="row-btn approve"
                                                    title="Activate">
                                                <svg width="14" height="14" fill="none"
                                                     viewBox="0 0 24 24"
                                                     stroke="currentColor" stroke-width="2.5">
                                                    <polyline points="20 6 9 17 4 12"/>
                                                </svg>
                                            </button>
                                        </form>
                                    }

                                    <form asp-action="Delete"
                                          asp-route-id="@rule.Id" method="post">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="row-btn danger"
                                                title="Delete"
                                                onclick="return confirm('Delete this rule?')">
                                            <svg width="14" height="14" fill="none"
                                                 viewBox="0 0 24 24"
                                                 stroke="currentColor" stroke-width="2">
                                                <polyline points="3 6 5 6 21 6"/>
                                                <path stroke-linecap="round"
                                                      stroke-linejoin="round"
                                                      d="M19 6l-1 14H6L5 6m5 0V4h4v2"/>
                                            </svg>
                                        </button>
                                    </form>

                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

</div>

@* Inline edit modal *@
<div class="modal-backdrop" id="editModal" style="display:none"
     onclick="if(event.target===this)this.style.display='none'">
    <div class="modal-card">
        <div class="modal-title">Edit Commission Rule</div>
        <form id="editForm" method="post">
            @Html.AntiForgeryToken()
            <div class="form-group" style="margin-bottom:14px">
                <label class="form-label">Rule Name <span>*</span></label>
                <input type="text" name="name" id="editName"
                       class="form-input" required />
            </div>
            <div class="form-group" style="margin-bottom:14px">
                <label class="form-label">Category ID
                    <span class="form-hint" style="display:inline">
                        — blank = global default
                    </span>
                </label>
                <input type="number" name="categoryId" id="editCategoryId"
                       class="form-input" />
            </div>
            <div class="form-group" style="margin-bottom:14px">
                <label class="form-label">Rate (%) <span>*</span></label>
                <input type="number" name="ratePercent" id="editRate"
                       class="form-input" step="0.01" min="0" max="100" required />
            </div>
            <div class="modal-actions">
                <button type="button" class="btn btn-outline"
                        onclick="document.getElementById('editModal').style.display='none'">
                    Cancel
                </button>
                <button type="submit" class="btn btn-primary">Save Changes</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        const rules = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
            Model.Rules.Select(r => new {
                id = r.Id,
                name = r.Name,
                categoryId = r.CategoryId,
                rate = r.RatePercent
            })));

        function openEdit(id) {
            const rule = rules.find(r => r.id == id);
            if (!rule) return;
            document.getElementById('editForm').action =
                '/payments/commission-rules/' + id + '/edit';
            document.getElementById('editName').value = rule.name;
            document.getElementById('editCategoryId').value =
                rule.categoryId ?? '';
            document.getElementById('editRate').value = rule.rate;
            document.getElementById('editModal').style.display = 'flex';
        }
    </script>
}